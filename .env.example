# Copy this file to .env for local runs. Do not commit real keys.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

MISTRAL_API_KEY=
# Deprecated compatibility alias: MISTRAK_API_KEY is still accepted, but prefer MISTRAL_API_KEY.

# Optional. The app defaults to mistral-small-latest when unset.
MISTRAL_MODEL=mistral-small-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional local Docker source-discovery helpers for SSC CGL imports.
SEARXNG_ENDPOINT=http://127.0.0.1:8888
FIRECRAWL_ENDPOINT=http://127.0.0.1:3002

# Optional external SSC CGL corpus location. Keep the raw book-PYQ JSON outside
# the repo and mount this folder into Docker when building or testing SSC data.
SSC_CGL_BOOK_IMPORTS_ROOT=/ssc-cgl-corpus/book-imports
